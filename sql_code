
-- Monday Coffee -- Data Analysis 

SELECT * FROM city;
SELECT * FROM products;
SELECT * FROM customers;
SELECT * FROM sales;

-- Reports & Data Analysis


-- Q.1 Coffee Consumers Count
-- How many people in each city are estimated to consume coffee, given that 25% of the population does?

select 
 city_name, population*25/100 as consumption_count
from city 
order by consumption_count desc

-- -- Q.2
-- Total Revenue from Coffee Sales
-- What is the total revenue generated from coffee sales across all cities in the last quarter of 2023?

select 
     ci.city_name,
     sum(s.total) as revenue
from sales as s
join customers as c
on s.customer_id = c.customer_id
join city as ci
on c.city_id = ci.city_id
where extract(month from s.sale_date) in (10,11,12)
      and 
      extract(year from s.sale_date) = 2023
group by ci.city_name
order by 2 desc


-- Q.3
-- Sales Count for Each Product
-- How many units of each coffee product have been sold?

select s.product_id,p.product_name, count(*) as units
from sales as s
right join products as p
on s.product_id = p.product_id
group by s.product_id,p.product_name
order by units desc

-- Q.4
-- Average Sales Amount per City
-- What is the average sales amount per customer in each city?

with my_cte as (select 
     c.city_name,sum(s.total) as total_revenue,count(distinct cu.customer_id) as unique_counts
from city as c
join customers as cu
on c.city_id = cu.city_id
join sales as s
on cu.customer_id = s.customer_id
group by c.city_name)
select city_name,  round(total_revenue::decimal/unique_counts,2) as average_sale_per_cx
from my_cte
order by average_sale_per_cx desc

-- -- Q.5
-- City Population and Coffee Consumers (25%)
-- Provide a list of cities along with their populations and estimated coffee consumers.
-- return city_name, total current cx, estimated coffee consumers (25%)

select
ci.city_name, count(distinct cu.customer_id) as active_cx,
round((ci.population * 0.25)/1000000,2) as estimated_cosumers_in_millions
from city as ci
join customers as cu
on ci.city_id = cu.city_id
group by ci.city_name,ci.population
order by 3 desc


-- -- Q6
-- Top Selling Products by City
-- What are the top 3 selling products in each city based on sales volume?

with
     my_cte as (select ci.city_name, p.product_name,sum(s.total) as revenue
from sales as s
join products as p
on   s.product_id = p.product_id
join customers as c
on   s.customer_id = c.customer_id
join city as ci
on   c.city_id = ci.city_id
group by 
     ci.city_name,p.product_name),
     second_cte as (select city_name, product_name,revenue, row_number() over (partition by city_name order by revenue desc) as ranks
from my_cte)
select 
     city_name,product_name,revenue
from second_cte
where 
     ranks <= 3


-- Q.7
-- Customer Segmentation by City
-- How many unique customers are there in each city who have purchased coffee products?

select 
     ci.city_name, count(distinct cu.customer_id) as coffee_cust_count
from products as p
join sales as s
on   p.product_id = s.product_id
join customers as cu
on   s.customer_id = cu.customer_id
join city as ci
on   cu.city_id = ci.city_id
where
     p.product_id <=14
group by 
     ci.city_name

-- -- Q.8
-- Average Sale vs Rent
-- Find each city and their average sale per customer and avg rent per customer

with my_cte as (select 
     c.city_name,sum(s.total) as total_revenue,c.estimated_rent as total_rent, count(distinct cu.customer_id) as unique_counts
from city as c
join customers as cu
on c.city_id = cu.city_id
join sales as s
on cu.customer_id = s.customer_id
group by c.city_name,c.estimated_rent)
select city_name,  round(total_revenue::decimal/unique_counts,2) as average_sale_per_cx,
                   round(total_rent::decimal/unique_counts,2) as average_rent_per_cx
from my_cte
order by average_sale_per_cx desc

-- Q.9
-- Monthly Sales Growth
-- Sales growth rate: Calculate the percentage growth (or decline) in sales over different time periods (monthly)
-- by each city

with monthly_sales as (
     select 
          ci.city_name,
          date_trunc('month', s.sale_date) as month,
          sum(s.total)::decimal as monthly_total
     from sales as s
     join customers as cu
     on s.customer_id = cu.customer_id
     join city as ci
     on cu.city_id = ci.city_id
     group by 
          ci.city_name, date_trunc('month', s.sale_date)
),
growth as (
     select 
          city_name,
          month,
          monthly_total,
          lag(monthly_total) over (partition by city_name order by month) as prev_month_total
     from 
          monthly_sales
)
select 
     city_name,
     to_char(month, 'YYYY-MM') as month,
     monthly_total,
     round(
          case 
               when prev_month_total = 0 or prev_month_total is null then null
               else ((monthly_total - prev_month_total) * 100.0) / prev_month_total
          end, 2
     ) as sales_growth_percentage
from 
     growth
order by 
     city_name, month;

-- Q.10
-- Market Potential Analysis
-- Identify top 3 city based on highest sales, return city name, total sale, total rent, total customers, estimated coffee consumer

with my_cte as (select ci.city_name,sum(s.total) as total_sales, ci.estimated_rent,
       count(distinct cu.customer_name) as total_customers,
	   round((ci.population*0.25)/1000000,2) as estimated_consumers_in_millions
from sales as s
join customers as cu
on s.customer_id = cu.customer_id
join city as ci
on cu.city_id = ci.city_id
group by ci.city_name,ci.estimated_rent,estimated_consumers_in_millions)
select  city_name, total_sales,total_customers, estimated_consumers_in_millions,
       round(total_sales::decimal/total_customers,2) as avg_sale_per_cx,
       round(estimated_rent::decimal/total_customers,2) as avg_rent_per_cx
from my_cte
order by total_sales desc

